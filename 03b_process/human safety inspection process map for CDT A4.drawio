        <mxCell id="human_bg" value="H. Human safety inspection workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="260" width="1098" height="340" as="geometry" />
        </mxCell>

        <mxCell id="start" value="H0. Start&#10;Work package released" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="120" height="62" as="geometry" />
        </mxCell>
        <mxCell id="build" value="H1. Execute work &amp; controls&#10;Build to drawings, method statement, permits and temporary-works design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="215" y="365" width="145" height="92" as="geometry" />
        </mxCell>
        <mxCell id="selfcheck" value="H2. Contractor self-check&#10;Confirm readiness, collect photos / measurements and fix visible defects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="395" y="365" width="155" height="92" as="geometry" />
        </mxCell>
        <mxCell id="invite" value="H3. Request &amp; pre-review&#10;Submit scope, checklist and evidence; inspector plans sampling route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="585" y="365" width="155" height="92" as="geometry" />
        </mxCell>
        <mxCell id="inspect" value="H4. Field inspection&#10;Observe, measure, sample and compare as-built state with I1-I3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="775" y="365" width="160" height="92" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="H5. Accept / conditional accept?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="970" y="354" width="122" height="114" as="geometry" />
        </mxCell>
        <mxCell id="close" value="H6. Close-out&#10;Accepted, signed off, registered and released" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="965" y="270" width="130" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ncr" value="H7. Record NCR / comments&#10;Location, violated rule, severity, action owner, deadline and evidence gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="742" y="500" width="220" height="82" as="geometry" />
        </mxCell>
        <mxCell id="critical" value="H8. Immediate danger?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="532" y="492" width="125" height="98" as="geometry" />
        </mxCell>
        <mxCell id="stopwork" value="H9. Stop / isolate / escalate&#10;Make area safe before correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="515" width="140" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rectify" value="H10. Correct &amp; verify&#10;Root cause, corrective action, updated work and evidence resubmission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="150" y="500" width="165" height="82" as="geometry" />
        </mxCell>

        <mxCell id="cdt_bg" value="C. CDT learning layer: convert human inspection evidence into learnable state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
