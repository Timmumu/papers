<mxCell id="title" value="CDT Step 3. Predict - Human Risk Forecasting Process" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="120" y="18" width="930" height="34" as="geometry" /></mxCell>
<mxCell id="note" value="Real project workflow for forward prediction: contextualised design features are tested against downstream DfS / DfQ exposure" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="140" y="52" width="890" height="24" as="geometry" /></mxCell>
<mxCell id="inputs_bg" value="P0. Prediction basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="1098" height="145" as="geometry" /></mxCell>
<mxCell id="kg" value="P1. Contextualised knowledge graph&#10;Design element, activity, temporary works, hazard, quality mode and rule links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="history" value="P2. Historical project cases&#10;Near-miss, NCR, rework, PFSS, cost, schedule and inspection outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="427" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="model" value="P3. Candidate prediction models&#10;Causal rules, GNN / ML predictor, Bayesian prior and expert risk matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="789" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="human_bg" value="H. Human prediction workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="260" width="1098" height="340" as="geometry" /></mxCell>
<mxCell id="start" value="H0. Start&#10;Design option ready" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="120" height="62" as="geometry" /></mxCell>
<mxCell id="scenario" value="H1. Define scenario&#10;Select element, phase, construction method and target DfS / DfQ outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="365" width="145" height="92" as="geometry" /></mxCell>
<mxCell id="features" value="H2. Confirm features&#10;Review causal inputs, proxy variables and missing-context warnings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="395" y="365" width="155" height="92" as="geometry" /></mxCell>
<mxCell id="run" value="H3. Run forecast&#10;Generate risk score, exposure class, uncertainty and evidence links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="365" width="155" height="92" as="geometry" /></mxCell>
<mxCell id="review" value="H4. Expert sanity check&#10;Planner / designer reviews plausibility, constructability and outliers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="775" y="365" width="160" height="92" as="geometry" /></mxCell>
<mxCell id="decision" value="H5. Prediction credible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354" width="122" height="114" as="geometry" /></mxCell>
<mxCell id="close" value="H6. Release risk forecast&#10;Ranked hazards, quality risks and intervention priority" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="270" width="130" height="65" as="geometry" /></mxCell>
<mxCell id="issue" value="H7. Investigate weak forecast&#10;Insufficient analogues, missing feature, drift, conflict or low confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="742" y="500" width="220" height="82" as="geometry" /></mxCell>
<mxCell id="decision2" value="H8. Need new context?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="532" y="492" width="125" height="98" as="geometry" /></mxCell>
<mxCell id="back" value="H9. Return to Step 2&#10;Request contextualisation update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="140" height="54" as="geometry" /></mxCell>
<mxCell id="adjust" value="H10. Adjust assumptions&#10;Revise scenario, feature set, model choice or expert prior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="165" height="82" as="geometry" /></mxCell>
<mxCell id="cdt_bg" value="C. CDT prediction layer: forward risk inference with uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="625" width="1098" height="170" as="geometry" /></mxCell>
<mxCell id="risk" value="C1. Risk vector&#10;Safety exposure, quality exposure, constructability and proxy-outcome likelihood" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="250" height="82" as="geometry" /></mxCell>
<mxCell id="explain" value="C2. Explanation package&#10;Top contributing design features, analogues, rules and confidence bounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="250" height="82" as="geometry" /></mxCell>
<mxCell id="handoff" value="C3. Handoff to Step 4&#10;Actionable warning set for design-stage decision making" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="675" width="250" height="82" as="geometry" /></mxCell>
