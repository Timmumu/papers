        <mxCell id="title" value="CDT Step 1. Perceive - Human Data Capture Process" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="120" y="18" width="930" height="34" as="geometry" /></mxCell>
        <mxCell id="note" value="Real project workflow for multimodal perception: design records, site sensing, cost proxies and quality evidence become CDT-ready observations" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="130" y="52" width="910" height="24" as="geometry" /></mxCell>

        <mxCell id="inputs_bg" value="P0. Perception sources and data governance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="1098" height="145" as="geometry" /></mxCell>
        <mxCell id="source_design" value="P1. Design and BIM package&#10;Geometry, elements, attributes, WBS, method assumptions and revision status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="128" width="315" height="85" as="geometry" /></mxCell>
        <mxCell id="source_site" value="P2. Site and sensor observations&#10;Photos, video, IoT streams, point clouds, inspections and safety walkdowns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="427" y="128" width="315" height="85" as="geometry" /></mxCell>
        <mxCell id="source_proxy" value="P3. Proxy outcome records&#10;PFSS / BoQ items, temporary works quantities, NCRs, rework and near-misses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="789" y="128" width="315" height="85" as="geometry" /></mxCell>

        <mxCell id="human_bg" value="H. Human perception workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="260" width="1098" height="340" as="geometry" /></mxCell>
        <mxCell id="start" value="H0. Start&#10;Perception need triggered" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="120" height="62" as="geometry" /></mxCell>
        <mxCell id="scope" value="H1. Define capture scope&#10;Element, zone, lifecycle phase, hazard / quality concern and required resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="365" width="145" height="92" as="geometry" /></mxCell>
        <mxCell id="collect" value="H2. Collect observations&#10;Acquire BIM exports, field media, measurements and proxy records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="395" y="365" width="155" height="92" as="geometry" /></mxCell>
        <mxCell id="align" value="H3. Align and tag&#10;Attach time, location, element ID, trade, activity and source provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="365" width="155" height="92" as="geometry" /></mxCell>
        <mxCell id="qa" value="H4. Data quality check&#10;Check completeness, calibration, duplicate records and traceability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="775" y="365" width="160" height="92" as="geometry" /></mxCell>
        <mxCell id="decision" value="H5. Fit for CDT ingestion?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354" width="122" height="114" as="geometry" /></mxCell>
        <mxCell id="close" value="H6. Release observation set&#10;Approved, versioned and ready for Contextualise" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="270" width="130" height="65" as="geometry" /></mxCell>
        <mxCell id="issue" value="H7. Resolve data gap&#10;Clarify missing source, repeat capture, repair metadata or exclude record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="500" width="215" height="82" as="geometry" /></mxCell>
        <mxCell id="owner" value="H8. Assign owner" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="532" y="492" width="125" height="98" as="geometry" /></mxCell>
        <mxCell id="block" value="H9. Block critical record&#10;Prevent unsafe model use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="140" height="54" as="geometry" /></mxCell>
        <mxCell id="repair" value="H10. Correct and resubmit&#10;Re-capture, relabel, convert format and update provenance log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="165" height="82" as="geometry" /></mxCell>

        <mxCell id="cdt_bg" value="C. CDT perception layer: turn raw project traces into structured observations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="625" width="1098" height="170" as="geometry" /></mxCell>
        <mxCell id="ingest" value="C1. Multimodal ingestion&#10;IFC / BIM, images, video, sensor series, text records and cost proxies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="250" height="82" as="geometry" /></mxCell>
        <mxCell id="feature" value="C2. Feature extraction&#10;Element attributes, spatial relations, activity states and proxy indicators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="250" height="82" as="geometry" /></mxCell>
