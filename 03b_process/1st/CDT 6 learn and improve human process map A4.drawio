<mxfile host="app.diagrams.net" agent="VS Code" version="24.0.0" type="device"><diagram id="cdt-6-learn-improve-human-process-a4" name="CDT 6 Learn and Improve"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="CDT Step 6. Learn and Improve - Human Model Governance Process" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="120" y="18" width="930" height="34" as="geometry" /></mxCell><mxCell id="note" value="Real project workflow for cross-project convergence: observed outcomes update the CDT, reduce prediction error and prepare the next iteration" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="125" y="52" width="920" height="24" as="geometry" /></mxCell>
<mxCell id="inputs_bg" value="P0. Learning basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="1098" height="145" as="geometry" /></mxCell><mxCell id="outcomes" value="P1. Verified outcome set&#10;Observed labels, confidence, prediction error and project context from Step 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="current" value="P2. Current CDT model state&#10;Model version, rules, priors, graph schema, feature definitions and limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="427" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="metric" value="P3. Governance criteria&#10;Error tolerance, convergence metric, validation set, audit rules and release gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="789" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="human_bg" value="H. Human learning and improvement workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="260" width="1098" height="340" as="geometry" /></mxCell><mxCell id="start" value="H0. Start&#10;Outcome batch closed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="120" height="62" as="geometry" /></mxCell><mxCell id="error" value="H1. Compute error&#10;Compare forecast with realised proxy outcomes and uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="365" width="145" height="92" as="geometry" /></mxCell><mxCell id="diagnose" value="H2. Diagnose learning need&#10;Identify drift, missing feature, rule conflict, rare case or noisy label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="395" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="update" value="H3. Select update action&#10;Retrain, Bayesian update, case-base addition, rule edit or no-change decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="validate" value="H4. Validate new model&#10;Back-test, compare baselines, check bias, explainability and convergence trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="775" y="365" width="160" height="92" as="geometry" /></mxCell><mxCell id="decision" value="H5. Release update?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354" width="122" height="114" as="geometry" /></mxCell><mxCell id="close" value="H6. Publish model version&#10;Updated CDT ready for next project / iteration" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="270" width="130" height="65" as="geometry" /></mxCell><mxCell id="issue" value="H7. Hold release&#10;Regression, weak evidence, poor explanation, unstable convergence or governance breach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="742" y="500" width="220" height="82" as="geometry" /></mxCell><mxCell id="decision2" value="H8. Fix model or data?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="532" y="492" width="125" height="98" as="geometry" /></mxCell><mxCell id="data" value="H9. Return to Step 5&#10;Clarify labels / outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="140" height="54" as="geometry" /></mxCell><mxCell id="modelrepair" value="H10. Repair update&#10;Revise features, priors, rules, training split or release threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="165" height="82" as="geometry" /></mxCell>
<mxCell id="cdt_bg" value="C. CDT improvement layer: measure convergence and preserve transferable knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="625" width="1098" height="170" as="geometry" /></mxCell><mxCell id="dashboard" value="C1. Convergence dashboard&#10;Prediction error, calibration, drift, confidence and cross-project trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="registry" value="C2. Model and rule registry&#10;Versioned model, feature schema, lessons learned and approved rule changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="handoff" value="C3. Loop to Step 1&#10;Updated perception requirements and reusable project knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="675" width="250" height="82" as="geometry" /></mxCell>
