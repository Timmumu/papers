<mxfile host="Electron" agent="VS Code">
  <diagram id="human-safety-inspection-cdt" name="Human Safety Inspection Process for CDT">
    <mxGraphModel dx="1471" dy="894" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" value="Human Safety Inspection Workflow for Contextualising a Cognitive Digital Twin (CDT)" vertex="1">
          <mxGeometry height="50" width="1580" x="590" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Purpose: rebuild the real human safety-inspection process so a CDT can later learn site context, compliance reasoning, inspection decision logic, and iterative rectification behavior.&#xa;&#xa;Key completeness additions beyond the 5-step loop: readiness review, inspection request package, evidence capture, non-compliance classification, stop-work escalation, root-cause and rectification planning, re-inspection loop, close-out records, and CDT learning signals." vertex="1">
          <mxGeometry height="130" width="560" x="80" y="90" as="geometry" />
        </mxCell>
        <mxCell id="lane_ref" parent="1" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" value="REFERENCE / COMPLIANCE KNOWLEDGE LAYER" vertex="1">
          <mxGeometry height="210" width="2700" x="80" y="250" as="geometry" />
        </mxCell>
        <mxCell id="ref_draw" parent="lane_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Approved drawings, BIM, temporary works design, method statement, ITP / hold points" vertex="1">
          <mxGeometry height="90" width="300" x="80" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ref_reg" parent="lane_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Regulations, codes, standards, project safety rules, permit-to-work requirements" vertex="1">
          <mxGeometry height="90" width="300" x="430" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ref_check" parent="lane_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Inspection checklist / acceptance criteria&#xa;- required controls&#xa;- tolerance / pass-fail rules&#xa;- evidence required" vertex="1">
          <mxGeometry height="110" width="330" x="780" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ref_prior" parent="lane_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Prior NCRs, lessons learned, site risk register, accident / near-miss history" vertex="1">
          <mxGeometry height="90" width="330" x="1160" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ref_records" parent="lane_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Final records: inspection form, photos, comments, rectification evidence, acceptance signature, close-out log" vertex="1">
          <mxGeometry height="100" width="360" x="2210" y="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_mc" parent="1" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=13;" value="MAIN CONTRACTOR (MC) - BUILD, SELF-CHECK, RECTIFY" vertex="1">
          <mxGeometry height="300" width="2700" x="80" y="460" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="lane_mc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="START&#xa;Work package released for construction" vertex="1">
          <mxGeometry height="70" width="190" x="80" y="95" as="geometry" />
        </mxCell>
        <mxCell id="mc_plan" parent="lane_mc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MC reviews construction context&#xa;- location / zone / element&#xa;- drawings and method statement&#xa;- required safety controls&#xa;- applicable regulations" vertex="1">
          <mxGeometry height="120" width="300" x="320" y="70" as="geometry" />
        </mxCell>
        <mxCell id="mc_build" parent="lane_mc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MC builds according to drawings and regulations&#xa;- execute work method&#xa;- install physical safety controls&#xa;- maintain permits and temporary works&#xa;- record as-built site state" vertex="1">
          <mxGeometry height="130" width="330" x="680" y="70" as="geometry" />
        </mxCell>
        <mxCell id="mc_self" parent="lane_mc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MC self-inspection / readiness check&#xa;- compare work vs drawing&#xa;- compare controls vs checklist&#xa;- collect photos / measurements&#xa;- fix obvious defects before calling inspector" vertex="1">
          <mxGeometry height="130" width="330" x="1080" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ready" parent="lane_mc" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Ready for formal inspection?" vertex="1">
          <mxGeometry height="120" width="220" x="1460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="mc_invite" parent="lane_mc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MC invites inspector&#xa;- inspection request / RFI&#xa;- work package ID&#xa;- drawings / method statement&#xa;- checklist and evidence package" vertex="1">
          <mxGeometry height="130" width="330" x="1760" y="70" as="geometry" />
        </mxCell>
        <mxCell id="mc_rectify" parent="lane_mc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="MC rectifies as per comments&#xa;- analyse non-compliance&#xa;- root cause and corrective action&#xa;- update physical work / controls&#xa;- collect rectification evidence&#xa;- update records" vertex="1">
          <mxGeometry height="140" width="330" x="2190" y="70" as="geometry" />
        </mxCell>
        <mxCell id="lane_insp" parent="1" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#fff3e0;strokeColor=#f57c00;fontStyle=1;fontSize=13;" value="INSPECTOR / SAFETY OFFICER - CHECK, DECIDE, COMMENT" vertex="1">
          <mxGeometry height="300" width="2700" x="80" y="760" as="geometry" />
        </mxCell>
        <mxCell id="insp_schedule" parent="lane_insp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Inspector receives request and schedules visit&#xa;- check readiness package&#xa;- confirm inspection scope&#xa;- prepare checklist" vertex="1">
          <mxGeometry height="115" width="330" x="1760" y="45" as="geometry" />
        </mxCell>
        <mxCell id="insp_site" parent="lane_insp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="On-site safety inspection&#xa;- observe actual site context&#xa;- compare drawing vs as-built&#xa;- compare regulations/checklist vs site condition&#xa;- interview workers / supervisor if needed&#xa;- capture photos, notes, measurements" vertex="1">
          <mxGeometry height="155" width="340" x="1370" y="45" as="geometry" />
        </mxCell>
        <mxCell id="accept" parent="lane_insp" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Safety works accepted?" vertex="1">
          <mxGeometry height="120" width="220" x="1010" y="60" as="geometry" />
        </mxCell>
        <mxCell id="comments" parent="lane_insp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Issue non-compliance comments / NCR&#xa;- location and element&#xa;- breached drawing / regulation / checklist item&#xa;- severity: minor / major / critical&#xa;- required rectification&#xa;- deadline and reinspection requirement" vertex="1">
          <mxGeometry height="165" width="330" x="620" y="35" as="geometry" />
        </mxCell>
        <mxCell id="critical" parent="lane_insp" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Critical immediate hazard?" vertex="1">
          <mxGeometry height="120" width="220" x="300" y="60" as="geometry" />
        </mxCell>
        <mxCell id="stopwork" parent="lane_insp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Stop work / isolate area / escalate to safety manager or authority if required" vertex="1">
          <mxGeometry height="130" width="180" x="80" y="55" as="geometry" />
        </mxCell>
        <mxCell id="close" parent="lane_insp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="CLOSED&#xa;Accepted and signed off" vertex="1">
          <mxGeometry height="80" width="220" x="2210" y="50" as="geometry" />
        </mxCell>
        <mxCell id="lane_cdt" parent="1" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;" value="CDT LEARNING / CONTEXTUALISATION LAYER" vertex="1">
          <mxGeometry height="340" width="2700" x="80" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="cdt_gnn" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="GNN / graph representation learns site construction context&#xa;- nodes: element, hazard, control, worker, equipment, location&#xa;- edges: spatial adjacency, dependency, work sequence, hazard exposure, responsibility" vertex="1">
          <mxGeometry height="135" width="420" x="320" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cdt_llm" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="LLM / rule reasoning learns textual compliance logic&#xa;- parse regulations, drawings notes, method statements, NCR comments&#xa;- map natural-language clauses to checklist criteria and site entities" vertex="1">
          <mxGeometry height="135" width="420" x="780" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cdt_multi" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Multimodal evidence ingestion&#xa;- photos / video / 360 scans&#xa;- sensor and location data&#xa;- checklist marks&#xa;- inspector notes and MC responses" vertex="1">
          <mxGeometry height="135" width="360" x="1240" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cdt_state" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="CDT updates site safety state&#xa;- current compliance state&#xa;- unresolved hazards / NCRs&#xa;- reinspection status&#xa;- acceptance history&#xa;- confidence and evidence trace" vertex="1">
          <mxGeometry height="145" width="360" x="1640" y="60" as="geometry" />
        </mxCell>
        <mxCell id="cdt_learn" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Learning target for CDT&#xa;- predict likely non-compliance before formal inspection&#xa;- explain why inspector accepts or rejects&#xa;- recommend rectification actions&#xa;- learn from repeated inspection loops" vertex="1">
          <mxGeometry height="145" width="410" x="2060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="quality" parent="lane_cdt" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="Process correctness review embedded in map:&#xa;1. Your 5-step loop is correct as the core accept / reject / rectify cycle.&#xa;2. For real construction, the loop needs readiness, evidence, classification, escalation, and close-out records.&#xa;3. For CDT learning, every decision must preserve context + evidence + rule reference + human rationale." vertex="1">
          <mxGeometry height="80" width="2390" x="80" y="220" as="geometry" />
        </mxCell>
