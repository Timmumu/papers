<mxfile host="app.diagrams.net" agent="VS Code" version="24.0.0" type="device"><diagram id="cdt-5-observe-human-process-a4" name="CDT 5 Observe"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="CDT Step 5. Observe - Human Outcome Verification Process" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="120" y="18" width="930" height="34" as="geometry" /></mxCell><mxCell id="note" value="Real project workflow for observing proxy outcome signals after design decisions and construction activities" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="160" y="52" width="850" height="24" as="geometry" /></mxCell>
<mxCell id="inputs_bg" value="P0. Outcome observation basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="1098" height="145" as="geometry" /></mxCell><mxCell id="plan" value="P1. Planned intervention record&#10;Warning, approved action, target element, expected risk reduction and proxy signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="site" value="P2. Construction / operation evidence&#10;Inspection results, near-miss logs, NCRs, rework, photos, sensors and test records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="427" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="baseline" value="P3. Baseline and target values&#10;Original prediction, acceptance threshold, observation window and data owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="789" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="human_bg" value="H. Human observation workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="260" width="1098" height="340" as="geometry" /></mxCell><mxCell id="start" value="H0. Start&#10;Intervention implemented" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="120" height="62" as="geometry" /></mxCell><mxCell id="window" value="H1. Set observation window&#10;Confirm timing, location, proxy indicators and responsible inspector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="365" width="145" height="92" as="geometry" /></mxCell><mxCell id="observe" value="H2. Observe actual outcome&#10;Inspect, measure, interview, review logs and capture field evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="395" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="label" value="H3. Label proxy outcome&#10;Encode near-miss, NCR, defect, rework, PFSS quantity or cycle score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="verify" value="H4. Verify evidence&#10;Check source quality, label consistency, time-order and linkage to design action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="775" y="365" width="160" height="92" as="geometry" /></mxCell><mxCell id="decision" value="H5. Outcome valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354" width="122" height="114" as="geometry" /></mxCell><mxCell id="close" value="H6. Release outcome set&#10;Verified proxy signal ready for learning" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="270" width="130" height="65" as="geometry" /></mxCell><mxCell id="issue" value="H7. Resolve observation issue&#10;Ambiguous cause, missing record, inconsistent label or late evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="742" y="500" width="220" height="82" as="geometry" /></mxCell><mxCell id="decision2" value="H8. Reobserve possible?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="532" y="492" width="125" height="98" as="geometry" /></mxCell><mxCell id="flag" value="H9. Flag weak label&#10;Use lower confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="140" height="54" as="geometry" /></mxCell><mxCell id="redo" value="H10. Reobserve / reconcile&#10;Repeat site check, obtain missing record or adjudicate label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="165" height="82" as="geometry" /></mxCell>
<mxCell id="cdt_bg" value="C. CDT observation layer: convert realised project events into learning signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="625" width="1098" height="170" as="geometry" /></mxCell><mxCell id="proxy" value="C1. Proxy outcome store&#10;Observed safety and quality signals linked to element, decision and phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="compare" value="C2. Prediction comparison&#10;Expected vs realised outcome, residual risk and error term" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="handoff" value="C3. Handoff to Step 6&#10;Validated labels, confidence and error evidence for model update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="675" width="250" height="82" as="geometry" /></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="start" target="window"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="window" target="observe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="observe" target="label"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="label" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="verify" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision" target="close"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision" target="issue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="issue" target="decision2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="decision2" target="flag"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision2" target="redo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="updated evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="redo" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="validated outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="close" target="proxy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="weak label" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="flag" target="proxy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;" edge="1" parent="1" source="proxy" target="compare"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;" edge="1" parent="1" source="compare" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="planned action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="plan" target="compare"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="field evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="site" target="proxy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="baseline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="baseline" target="compare"><mxGeometry relative="1" as="geometry" /></mxCell>
