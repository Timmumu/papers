<mxfile host="app.diagrams.net" agent="VS Code" version="24.0.0" type="device"><diagram id="cdt-4-decide-warn-human-process-a4" name="CDT 4 Decide and Warn"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="CDT Step 4. Decide and Warn - Human Intervention Process" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="120" y="18" width="930" height="34" as="geometry" /></mxCell><mxCell id="note" value="Real project workflow for Prevention-through-Design: forecasts become design warnings, alternatives, approvals and traceable decisions" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="140" y="52" width="890" height="24" as="geometry" /></mxCell>
<mxCell id="inputs_bg" value="P0. Decision basis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="90" width="1098" height="145" as="geometry" /></mxCell><mxCell id="risk" value="P1. Risk forecast package&#10;Exposure score, severity, uncertainty, explanation and affected elements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="65" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="options" value="P2. Design and method alternatives&#10;Geometry change, sequence change, temporary works, controls and substitution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="427" y="128" width="315" height="85" as="geometry" /></mxCell><mxCell id="constraints" value="P3. Decision constraints&#10;Cost, schedule, constructability, code compliance, owner preference and residual risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="789" y="128" width="315" height="85" as="geometry" /></mxCell>
<mxCell id="human_bg" value="H. Human warning and decision workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="260" width="1098" height="340" as="geometry" /></mxCell><mxCell id="start" value="H0. Start&#10;High-risk forecast received" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="120" height="62" as="geometry" /></mxCell><mxCell id="triage" value="H1. Triage warning&#10;Classify urgency, owner, affected package and approval path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="365" width="145" height="92" as="geometry" /></mxCell><mxCell id="review" value="H2. Convene review&#10;Designer, planner, safety, quality, contractor and owner review evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="395" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="alternative" value="H3. Generate alternatives&#10;Revise design / method, add controls, change sequence or justify residual risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="585" y="365" width="155" height="92" as="geometry" /></mxCell><mxCell id="evaluate" value="H4. Evaluate trade-offs&#10;Compare risk reduction, quality effect, cost, schedule and constructability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="775" y="365" width="160" height="92" as="geometry" /></mxCell><mxCell id="decision" value="H5. Approve intervention?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354" width="122" height="114" as="geometry" /></mxCell><mxCell id="close" value="H6. Issue warning / change&#10;Design note, control action, residual risk and owner sign-off" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="965" y="270" width="130" height="65" as="geometry" /></mxCell><mxCell id="reject" value="H7. Record rejection / hold&#10;Reason, missing evidence, unacceptable trade-off or authority decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="742" y="500" width="220" height="82" as="geometry" /></mxCell><mxCell id="decision2" value="H8. Need prediction rerun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="532" y="492" width="125" height="98" as="geometry" /></mxCell><mxCell id="rerun" value="H9. Return to Step 3&#10;Forecast revised option" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="140" height="54" as="geometry" /></mxCell><mxCell id="revise" value="H10. Revise alternative&#10;Modify controls, assumptions, stakeholders or acceptance criteria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="165" height="82" as="geometry" /></mxCell>
<mxCell id="cdt_bg" value="C. CDT decision layer: make warnings explainable and auditable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="35" y="625" width="1098" height="170" as="geometry" /></mxCell><mxCell id="alert" value="C1. Warning record&#10;Trigger, threshold, evidence chain, notified parties and response time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="decisionlog" value="C2. Decision rationale&#10;Selected option, rejected options, trade-off scores and residual risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="675" width="250" height="82" as="geometry" /></mxCell><mxCell id="handoff" value="C3. Handoff to Step 5&#10;Planned intervention and observable proxy outcomes to verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b1fa2;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="675" width="250" height="82" as="geometry" /></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="start" target="triage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="triage" target="review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="review" target="alternative"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="alternative" target="evaluate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="evaluate" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision" target="close"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision" target="reject"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="reject" target="decision2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="decision2" target="rerun"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="decision2" target="revise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="new option" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="revise" target="alternative"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="warning" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="close" target="alert"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="review evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="review" target="decisionlog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;" edge="1" parent="1" source="alert" target="decisionlog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7b1fa2;strokeWidth=2;" edge="1" parent="1" source="decisionlog" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="forecast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="risk" target="alert"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="alternatives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=11;" edge="1" parent="1" source="options" target="decisionlog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="constraints" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#7b1fa2;fontSize=